---
import { experience } from '../data/cv';
import { site } from '../data/site';

const [emailUser, emailDomain] = site.email.split('@');
---

<div class="text-[13px] leading-relaxed sm:text-sm">
  <p>
    <span class="text-term-amber">commit 7f3a9c2e1b4d8a6f</span>
    <span class="text-term-cyan">(HEAD -&gt; main, tag: actualidad)</span>
  </p>
  <p class="text-term-text">
    Author: Pablo Bagliere <span class="text-term-dim">&lt;</span><span
      class="text-term-dim"
      data-mail-text
      data-u={emailUser}
      data-d={emailDomain}>{emailUser} [arroba] {emailDomain}</span
    ><span class="text-term-dim">&gt;</span>
  </p>
  <p class="text-term-text">Date: <span class="text-term-text">{experience.period}</span></p>

  <div class="mt-5 space-y-1.5">
    <p class="font-bold text-term-green">
      {experience.role} · {experience.company}
    </p>
    <p class="text-term-dim">{experience.description}</p>
  </div>

  <div class="mt-5 border-t border-term-border/60 pt-4">
    <p class="mb-2 text-term-dim">diff --responsabilidades:</p>
    <ul class="space-y-1.5">
      {
        experience.responsibilities.map((r) => (
          <li class="flex gap-2">
            <span class="shrink-0 text-term-green">+</span>
            <span>{r}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="mt-5 border-t border-term-border/60 pt-3 text-xs text-term-dim">
    {experience.responsibilities.length} áreas de responsabilidad · 5+ años de impacto · 0 conflictos
    de merge
  </p>
</div>
