---
import { skills } from '../data/cv';
---

<div class="grid gap-x-10 gap-y-7 text-[13px] sm:text-sm md:grid-cols-2">
  {
    skills.map((group) => (
      <div>
        <p class="mb-2 text-term-dim"># {group.category}</p>
        <ul class="space-y-1">
          {group.items.map((item) => (
            <li class="flex items-baseline justify-between gap-2">
              <span>
                <span class="text-term-text">{item.toLowerCase().replace(/[\s/.]+/g, '-')}</span>
                <span class="text-term-dim">/stable</span>
              </span>
              <span class="shrink-0 text-term-green">[installed]</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
<p class="mt-7 text-xs text-term-dim">
  # {skills.reduce((acc, g) => acc + g.items.length, 0)} paquetes instalados · 0 vulnerabilidades
  críticas conocidas (humor)
</p>
